# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
# Use pk_test / sk_test for development, pk_live / sk_live for production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → Add endpoint)
# Endpoint URL: https://<your-vercel-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (keep these as-is)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Backend API ───────────────────────────────────────────────────────────────
# Local dev:     http://localhost:8000
# Render deploy: https://nepaljobai-api.onrender.com  (copy from Render dashboard)
NEXT_PUBLIC_API_BASE_URL=https://nepaljobai-api.onrender.com
