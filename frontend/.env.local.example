# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored. Never commit real keys.

# ─── Clerk (auth) ────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your project → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx

# Clerk webhook signing secret (Settings → Webhooks → Add endpoint)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (these match the routes we built)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Backend API ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000